# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Meta / Instagram
INSTAGRAM_PAGE_ACCESS_TOKEN=    # From Meta Developer App → Access Tokens
INSTAGRAM_APP_SECRET=           # From Meta Developer App → Settings → Basic
INSTAGRAM_VERIFY_TOKEN=         # You make this up — any random string

# Supabase
SUPABASE_URL=                   # Project Settings → API → Project URL
SUPABASE_KEY=                   # Project Settings → API → service_role key (not anon)

# Booking
BOOKING_LINK=                   # Calendly / Cal.com / etc. URL the bot sends at step 9
